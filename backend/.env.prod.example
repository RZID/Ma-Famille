# Production env for the HOME SERVER only. Copy to backend/.env there.
# Never commit the filled file. Values below are safe placeholders.
APP_NAME=ma-famille-api
APP_ENV=production
API_V1_PREFIX=/api/v1
ROOT_PATH=/ma-famille
BACKEND_CORS_ORIGINS=https://college.rzidinc.com
# Database lives on a separate VM — point at its LAN IP. compose.prod.yml
# does NOT override this (it only sets ROOT_PATH).
DATABASE_URL=postgresql+psycopg://mafamille:change-me@192.168.1.51:5432/mafamille
POSTGRES_USER=mafamille
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mafamille
# Random 32+ chars, e.g. output of: python3 -c "import secrets;print(secrets.token_hex(24))"
MANAGER_TOKEN=change-me
# DOKU sandbox (https://sandbox.doku.com)
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
DOKU_BASE_URL=https://api-sandbox.doku.com
