# Root env template. Copy to .env where needed.
# Frontend reads VITE_* vars at build time. Backend reads via pydantic-settings.

# Frontend -> Backend URL used by axios client
VITE_API_URL=http://localhost:8000

# Backend
APP_NAME=ma-famille-api
APP_ENV=development
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
DATABASE_URL=postgresql+psycopg://mafamille:mafamille@localhost:5432/mafamille
# DOKU sandbox — leave empty to keep 501 stubs
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
DOKU_BASE_URL=https://api-sandbox.doku.com
# Empty = open (local dev). Production sets a random token.
MANAGER_TOKEN=
